  <input type="checkbox" id="nav-toggle" class="sr-only" aria-label="Mở menu điều hướng" />

  <div class="nav__inner">
    <a class="nav__logo" href="trangchu.html">Hương Vị Việt</a>

    <nav class="nav__desktop">
      <a class="nav__link is-active" href="trangchu.html">Trang Chủ</a>
      <a class="nav__link" href="thucdon.html">Thực Đơn</a>
      <a class="nav__cta" href="datban.html">Đặt Bàn</a>
    </nav>

    <label class="nav__burger" for="nav-toggle">
      <span></span><span></span><span></span>
    </label>
  </div>

  <nav class="nav__mobile">
    <a class="is-active" href="trangchu.html">Trang Chủ</a>
    <a href="thucdon.html">Thực Đơn</a>
    <a href="datban.html">Đặt Bàn</a>
  </nav>
</header>

<main>

  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <img class="hero__bg"
         src="https://images.unsplash.com/photo-1709548145082-04d0cde481d4?w=1600&h=900&fit=crop&auto=format"
         alt="Không gian nhà hàng Hương Vị Việt" />
    <div class="hero__veil"></div>

    <div class="hero__inner">
      <p class="eyebrow hero__eyebrow">— Ẩm Thực Truyền Thống Việt Nam</p>
      <h1 class="hero__title">
        Hương Vị<br /><em class="accent">Từ Trái Tim</em>
      </h1>
      <p class="hero__lede">
        Từng món ăn là câu chuyện của quê hương — nơi ký ức, hương thơm và tình yêu
        hoà quyện trong từng muỗng canh nóng hổi.
      </p>
      <div class="hero__actions">
        <a class="btn btn--gold" href="thucdon.html">Xem Thực Đơn</a>
        <a class="btn btn--ghost" href="datban.html">Đặt Bàn Ngay</a>
      </div>
    </div>

    <div class="scroll-cue">
      <p class="scroll-cue__label">Cuộn xuống</p>
      <div class="scroll-cue__line"></div>
    </div>
  </section>

  <!-- ===================== SỐ LIỆU ===================== -->
  <section class="stats">
    <div class="stats__grid">
      <div class="stat">
        <p class="stat__num">1987</p>
        <p class="stat__label">Năm thành lập</p>
        <p class="stat__note">Hơn 35 năm giữ lửa</p>
      </div>
      <div class="stat">
        <p class="stat__num">120+</p>
        <p class="stat__label">Món ăn đặc sắc</p>
        <p class="stat__note">Từ Bắc vào Nam</p>
      </div>
      <div class="stat">
        <p class="stat__num">4.9★</p>
        <p class="stat__label">Đánh giá khách hàng</p>
        <p class="stat__note">Trên Google &amp; Foody</p>
      </div>
    </div>
  </section>

  <!-- ===================== CÂU CHUYỆN ===================== -->
  <section class="story">
    <div>
      <p class="eyebrow eyebrow--sm story__eyebrow">Câu chuyện của chúng tôi</p>
      <h2 class="story__title">
        Bếp lửa truyền qua<br /><em class="accent">ba thế hệ</em>
      </h2>
      <p class="story__text">
        Khởi đầu từ gánh hàng ăn nhỏ của bà nội tại chợ Bến Thành năm 1987, Hương Vị Việt
        được xây dựng trên triết lý đơn giản: nguyên liệu tươi mỗi ngày, công thức gia truyền
        không thay đổi.
      </p>
      <p class="story__text story__text--last">
        Đến nay, thế hệ thứ ba vẫn giữ nguyên linh hồn của những món ăn đó — chỉ thêm không
        gian đẹp hơn cho thực khách thưởng thức.
      </p>
      <a class="link-underline" href="thucdon.html">Khám phá thực đơn →</a>
    </div>

    <div class="story__media">
      <img class="story__photo"
           src="https://images.unsplash.com/photo-1641440615059-42c8ed3af8c8?w=700&h=860&fit=crop&auto=format"
           alt="Các món ăn đặc sắc của nhà hàng" />
      <figure class="quote-card">
        <p class="quote-card__text">"Ăn là để nhớ, không phải chỉ để no."</p>
        <p class="quote-card__by">— Bà Nguyễn Thị Hoa, người sáng lập</p>
      </figure>
    </div>
  </section>

  <!-- ===================== MÓN NỔI BẬT ===================== -->
  <section class="featured">
    <div class="shell">
      <div class="featured__head">
        <div>
          <p class="eyebrow eyebrow--sm featured__eyebrow">Được yêu thích nhất</p>
          <h2 class="section-title featured__title">Món Nổi Bật</h2>
        </div>
        <a class="btn--outline" href="thucdon.html">Xem tất cả →</a>
      </div>

      <div class="featured__grid">
        <a class="dish-tile" href="thucdon.html">
          <img class="dish-tile__img"
               src="https://images.unsplash.com/photo-1701480253822-1842236c9a97?w=600&h=400&fit=crop&auto=format"
               alt="Phở Bò Đặc Biệt" />
          <div class="dish-tile__overlay">
            <p class="dish-tile__desc">Nước dùng hầm xương 12 tiếng, thịt bò tái, gân, gầu, kèm rau thơm.</p>
          </div>
          <div class="dish-tile__meta">
            <p class="dish-tile__name">Phở Bò Đặc Biệt</p>
            <p class="dish-tile__price">85.000₫</p>
          </div>
        </a>

        <a class="dish-tile" href="thucdon.html">
          <img class="dish-tile__img"
               src="https://images.unsplash.com/photo-1555126634-323283e090fa?w=600&h=400&fit=crop&auto=format"
               alt="Bún Bò Huế" />
          <div class="dish-tile__overlay">
            <p class="dish-tile__desc">Nước dùng sả cay đặc trưng, bò &amp; chả, bún sợi to, huyết luộc.</p>
          </div>
          <div class="dish-tile__meta">
            <p class="dish-tile__name">Bún Bò Huế</p>
            <p class="dish-tile__price">75.000₫</p>
          </div>
        </a>

        <a class="dish-tile" href="thucdon.html">
          <img class="dish-tile__img"
               src="https://images.unsplash.com/photo-1533787761082-492a5b83e614?w=600&h=400&fit=crop&auto=format"
               alt="Cháo Gà Ta" />
          <div class="dish-tile__overlay">
            <p class="dish-tile__desc">Cháo gạo lứt nấu từ gà ta thả vườn, hành lá, gừng tươi.</p>
          </div>
          <div class="dish-tile__meta">
            <p class="dish-tile__name">Cháo Gà Ta</p>
            <p class="dish-tile__price">65.000₫</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== ĐẶT BÀN ===================== -->
  <section class="cta">
    <img class="cta__bg"
         src="https://images.unsplash.com/photo-1650490632010-e18cbb694dd1?w=1600&h=500&fit=crop&auto=format"
         alt="Không gian nhà hàng" />
    <div class="cta__veil"></div>

    <div class="cta__inner">
      <p class="eyebrow eyebrow--sm cta__eyebrow">Đặt chỗ trước để có trải nghiệm tốt nhất</p>
      <h2 class="cta__title">
        Dành Một Buổi Tối<br /><em class="accent">Thật Đặc Biệt</em>
      </h2>
      <div class="cta__actions">
        <a class="btn btn--gold" href="datban.html">Đặt Bàn Ngay</a>
        <a class="btn btn--ghost" href="tel:02838245678">Gọi 028 3824 5678</a>
      </div>
      <p class="cta__note">Hoặc gọi trực tiếp: <span>028 3824 5678</span></p>
    </div>
  </section>

